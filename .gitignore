# ── Arduino / ESP32 build artifacts ──────────────────────────────────────────
build/
.build/
*.bin
*.elf
*.map
*.hex

# ── macOS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.pyc
tools/fonts/*.otf
tools/fonts/*.ttf
*.bak
*.swp
.vscode/

# ── Safety: never commit real credentials ────────────────────────────────────
# secrets.h ships with "...." placeholders and is tracked as a build template.
# Do not paste real keys into source files. Enter credentials through the
# device provisioning page so they remain in the device's NVS configuration.
